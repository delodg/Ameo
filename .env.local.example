# =========================================================
# Ameo (xiaozhi-esp32 fork) - Local environment configuration
# Copy this file to ".env.local" and fill in your real values.
# ".env.local" is git-ignored and never committed.
# =========================================================

# --- OpenRouter (LLM provider) ---
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any model available on OpenRouter, e.g.:
#   openai/gpt-4o-mini
#   anthropic/claude-3.5-sonnet
#   deepseek/deepseek-chat
#   meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional generation params
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=500

# --- Voice / TTS (Argentine Rioplatense Spanish) ---
# Microsoft EdgeTTS neural voices for Argentina:
#   es-AR-ElenaNeural  (female)
#   es-AR-TomasNeural  (male)
ASSISTANT_TTS_VOICE=es-AR-ElenaNeural

# --- ASR (Speech-to-Text) ---
# The local/offline ASR (SenseVoiceSmall) only supports zh/en/ja/ko/yue,
# NOT Spanish. By default Ameo uses OpenRouter's audio-input chat model
# (reuses OPENROUTER_API_KEY above, no extra signup needed) to transcribe.
OPENROUTER_ASR_MODEL=openai/gpt-audio-mini

# Optional: use Groq's Whisper instead (uncomment/set a real key to
# switch). Groq is faster/cheaper but needs its own free API key at
# https://console.groq.com/keys
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_ASR_MODEL=whisper-large-v3-turbo

# --- Local xiaozhi-server (backend that the ESP32 talks to) ---
# LAN IP of the machine running the Python backend (NOT 127.0.0.1,
# the ESP32 needs to reach it over WiFi). Find it with `ipconfig`.
SERVER_LAN_IP=192.168.1.100
SERVER_WS_PORT=8000
SERVER_HTTP_PORT=8003
